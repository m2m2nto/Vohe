# Copy to .env.local for local development, and set the same two variables
# in the Vercel project settings (Environment Variables).

# Neon/Vercel Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string used to sign session tokens, for the browser and the app alike.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET=change-me

# There is no password here: accounts live in the database. Create one with
#   npm run user:create -- <username> '<password>' --admin
