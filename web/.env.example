# Copy to .env.local for local development, and set the same three variables
# in the Vercel project settings (Environment Variables).

# Neon/Vercel Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The single password that unlocks the editor.
ADMIN_PASSWORD=change-me

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# Bearer token the iOS app sends to /api/*. Generate one the same way as
# AUTH_SECRET, and paste it into Vohe under the cloud button → Server settings.
# Leave it unset and the API stays closed to everyone.
API_TOKEN=change-me
